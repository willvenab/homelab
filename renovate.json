{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "docker-compose": {
    "fileMatch": ["(^|/)compose\\.ya?ml$"]
  },
  "packageRules": [
    {
      "description": "Komodo's DB images can break on update; review these by hand",
      "matchPackageNames": ["ghcr.io/ferretdb/**"],
      "automerge": false,
      "groupName": "ferretdb"
    },
    {
      "description": "Patch bumps for app images are low risk",
      "matchUpdateTypes": ["patch", "digest"],
      "matchFileNames": ["stacks/**"],
      "automerge": true
    },
    {
      "description": "Hermes WebUI is tracked by the custom manager below instead",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/nesquena/hermes-webui"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "Hermes WebUI's stable and experimental builds share one tag series on ghcr.io, so take versions from its stable GitHub releases (vX.Y.Z, not exp-vX.Y.Z)",
      "customType": "regex",
      "fileMatch": ["(^|/)compose\\.ya?ml$"],
      "matchStrings": ["image: ghcr\\.io/nesquena/hermes-webui:(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "nesquena/hermes-webui",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
