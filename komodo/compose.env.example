## Komodo environment. bootstrap/install.sh copies this to /etc/komodo/core/compose.env
## and fills every CHANGEME with a random value. Never commit the real file.
## Full option list:
##   https://github.com/moghtech/komodo/blob/main/compose/compose.env
##   https://github.com/moghtech/komodo/blob/main/config/core.config.toml

COMPOSE_KOMODO_IMAGE_TAG=2.3.3
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=CHANGEME

TZ=Etc/UTC

#= Core =#
KOMODO_HOST=http://elitedesk.lan:9120
KOMODO_TITLE=Homelab
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=CHANGEME
KOMODO_DISABLE_USER_REGISTRATION=true

## Must match the server name in komodo/syncs/server.toml.
KOMODO_FIRST_SERVER_NAME=elitedesk
KOMODO_DISABLE_INIT_RESOURCES=false

KOMODO_WEBHOOK_SECRET=CHANGEME
KOMODO_JWT_SECRET=CHANGEME
KOMODO_JWT_TTL="1-wk"

#= Single sign-on through Authelia (README → "Single sign-on") =#
## Uncomment once the authelia stack is running. KOMODO_HOST above must then be
## https://komodo.<DOMAIN>, since Komodo builds the OIDC redirect URL from it.
## The client secret is printed by stacks/authelia/setup.sh.
# KOMODO_OIDC_ENABLED=true
# KOMODO_OIDC_PROVIDER=https://auth.example.com
# KOMODO_OIDC_CLIENT_ID=komodo
# KOMODO_OIDC_CLIENT_SECRET=
## Skip Komodo's login page. Use komodo.<DOMAIN>/login?disableAutoLogin=true to
## log in as the local admin.
# KOMODO_OIDC_AUTO_REDIRECT=true
## Let Authelia users sign up. They start disabled until an admin enables
## them. Local sign-up stays off.
# KOMODO_DISABLE_LOCAL_USER_REGISTRATION=true
# KOMODO_DISABLE_OIDC_USER_REGISTRATION=false

## Slower polling = less CPU on an old box.
KOMODO_MONITORING_INTERVAL="1-min"
KOMODO_RESOURCE_POLL_INTERVAL="15-min"

#= Periphery =#
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
