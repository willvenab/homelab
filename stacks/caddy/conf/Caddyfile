# One wildcard cert for *.{$DOMAIN} from Let's Encrypt, via a Cloudflare DNS
# challenge. Nothing needs to be reachable from the internet, and only the
# wildcard (not each service name) shows up in public certificate logs.
#
# To add a service: add a matcher + handle pair below. If the app has no login
# of its own (or no OIDC support), add `import authelia` before reverse_proxy.

# Ask Authelia before proxying. Not logged in: redirect to auth.{$DOMAIN}.
(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

*.{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Check the challenge record against public DNS, not AdGuard,
		# whose rewrite for *.{$DOMAIN} would hide it.
		resolvers 1.1.1.1 1.0.0.1
	}

	@auth host auth.{$DOMAIN}
	handle @auth {
		reverse_proxy authelia:9091
	}

	# Komodo and Beszel log in through Authelia themselves (OIDC).
	@komodo host komodo.{$DOMAIN}
	handle @komodo {
		reverse_proxy core:9120
	}

	@beszel host beszel.{$DOMAIN}
	handle @beszel {
		reverse_proxy beszel:8090
	}

	@adguard host adguard.{$DOMAIN}
	handle @adguard {
		import authelia
		# The UI is on 80 once set up; before that, the setup wizard is on 3000.
		reverse_proxy adguard:80 adguard:3000 {
			lb_policy first
			lb_try_duration 2s
		}
	}

	@homepage host home.{$DOMAIN}
	handle @homepage {
		import authelia
		reverse_proxy homepage:3000
	}

	@osrs host osrs.{$DOMAIN}
	handle @osrs {
		import authelia
		reverse_proxy osrs-tools:3000
	}

	@pdf host pdf.{$DOMAIN}
	handle @pdf {
		import authelia
		reverse_proxy stirling-pdf:8080
	}

	# Logs in through Authelia itself (OIDC).
	@hermes host hermes.{$DOMAIN}
	handle @hermes {
		reverse_proxy hermes:9119
	}

	# Hermes WebUI. Logs in through Authelia itself (OIDC).
	@chat host chat.{$DOMAIN}
	handle @chat {
		reverse_proxy hermes-webui:8787
	}

	# Unknown subdomain: plain 404.
	handle {
		respond "Unknown service" 404
	}
}
